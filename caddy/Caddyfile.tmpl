# Rendered by setup.sh — edit the .tmpl, not the output.
{{LORE_HOST}} {
    # Fronts Lore's HTTP health endpoint and drives ACME issuance for
    # LORE_HOST. Lore's real traffic is QUIC (UDP 41337) and bypasses Caddy.
    reverse_proxy lore:41339
}

{{LORE_AUTH_HOST}} {
    # gRPC (h2c) to the internal auth service: UCS-compatible token exchange
    # for the lore CLI and ReBAC for loreserver. Caddy terminates TLS here.
    reverse_proxy h2c://auth:8080
}

{{LORE_WEB_HOST}} {
    # Read-only web frontend (kaguya-web BFF). Caddy terminates TLS and proxies
    # to the internal HTTP service.
    reverse_proxy web:8090
}
