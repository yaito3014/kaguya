# Copy to .env and edit. `./setup.sh` renders the *.tmpl configs from these.

# Lore server hostname (A record -> this VPS, DNS-only / grey cloud).
# Doubles as the Dex client_id and the JWT audience (host = client_id = aud).
LORE_HOST=lore.example.com
# Public host for the auth/ReBAC gRPC service (CNAME to this VPS). Both the
# lore CLI and loreserver connect here for token exchange and authorization.
LORE_AUTH_HOST=auth.lore.example.com
# Public host for the read-only web frontend (CNAME to this VPS). It is the
# redirect host for OIDC login (register the callback in the IdP's OIDC client).
LORE_WEB_HOST=app.lore.example.com

# OIDC identity provider (Authentik "lore" application on the yachiyo VPS).
# kaguya-auth verifies identity tokens against this issuer (discovery-based), and
# the web frontend runs its auth-code login here. LORE_OIDC_CLIENT_ID is the
# OIDC client id, shared by the CLI (device flow) and the web (code + PKCE); the
# token audience equals it, which must match KAGUYA_JWT_AUDIENCE (= LORE_HOST).
OIDC_ISSUER=https://id.example.com/application/o/lore/
LORE_OIDC_CLIENT_ID=lore.example.com
